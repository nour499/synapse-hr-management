# ── Base de données PostgreSQL ──────────────────────
DB_URL=jdbc:postgresql://localhost:5433/grh
DB_USERNAME=grh
DB_PASSWORD=grh

# ── Keycloak (realm gerai, client gerai) ───────────
KC_SERVER_URL=http://localhost:8080
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=admin
KC_TARGET_REALM=gerai
KC_ISSUER_URI=http://localhost:8080/realms/gerai
KC_CLIENT_ID=gerai

# ── Mail (optionnel) ────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Uploads ─────────────────────────────────────────
FILE_UPLOAD_DIR=C:/gerai/uploads/employe

# ── Kafka (optionnel) ───────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_NOTIFICATIONS=notification-events
